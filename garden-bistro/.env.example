DATABASE_URL=postgresql://user:password@localhost:5432/garden_bistro
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Generate hash using: npx tsx scripts/password.ts 'your-long-password'
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=info@gardenbistro.net
# Set only after selecting a verified production domain
SITE_URL=
# Explicitly enable indexing only on production
ALLOW_INDEXING=false
